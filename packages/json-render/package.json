{
  "name": "@genui-guard/json-render",
  "version": "0.4.1",
  "description": "json-render adapter for genui-guard. Translates specs and JSONL patches to guard events and back.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@genui-guard/core": "workspace:*"
  },
  "peerDependencies": {
    "@json-render/core": "0.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@json-render/core": "0.21.0",
    "zod": "^4.3.6"
  },
  "sideEffects": false,
  "keywords": [
    "generative-ui",
    "guardrails",
    "llm",
    "ai-safety",
    "provenance",
    "json-render",
    "trust",
    "agent"
  ],
  "homepage": "https://github.com/siddharthagrawal/genui-guard/tree/main/packages/json-render#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siddharthagrawal/genui-guard.git",
    "directory": "packages/json-render"
  },
  "bugs": {
    "url": "https://github.com/siddharthagrawal/genui-guard/issues"
  },
  "author": "Siddharth Agrawal (https://github.com/siddharthagrawal)",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
